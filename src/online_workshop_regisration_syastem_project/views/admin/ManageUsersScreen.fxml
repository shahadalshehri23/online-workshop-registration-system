<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="540.0" prefWidth="760.0"
            style="-fx-background-color: #f4f6f7;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="online_workshop_regisration_syastem_project.controllers.admin.ManageUsersController">

    <top>
        <HBox alignment="CENTER" style="-fx-background-color: #16a085; -fx-padding: 18;">
            <Label text="Manage Users"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />
        </HBox>
    </top>

    <center>
        <VBox spacing="10.0">
            <padding>
                <Insets top="20.0" right="25.0" bottom="20.0" left="25.0" />
            </padding>

            <Label text="All registered users:"
                   style="-fx-font-weight: bold; -fx-text-fill: #0e6655;" />

            <GridPane fx:id="usersGrid" hgap="15.0" vgap="10.0" style="-fx-background-color: white; -fx-padding: 12;">

                <!-- Header -->
                <Label text="Name" style="-fx-font-weight: bold; -fx-text-fill: #0e6655;"
                       GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label text="Email" style="-fx-font-weight: bold; -fx-text-fill: #0e6655;"
                       GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="Role" style="-fx-font-weight: bold; -fx-text-fill: #0e6655;"
                       GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <Label text="Edit" style="-fx-font-weight: bold; -fx-text-fill: #0e6655;"
                       GridPane.columnIndex="3" GridPane.rowIndex="0" />
                <Label text="Remove" style="-fx-font-weight: bold; -fx-text-fill: #0e6655;"
                       GridPane.columnIndex="4" GridPane.rowIndex="0" />
            </GridPane>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 15;">
            <Button fx:id="addUserButton" text="Add User" prefWidth="160.0"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16 8 16;" />
            <Button fx:id="backButton" text="Back" prefWidth="140.0"
                    style="-fx-background-color: #566573; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16 8 16;" />
        </HBox>
    </bottom>

</BorderPane>
