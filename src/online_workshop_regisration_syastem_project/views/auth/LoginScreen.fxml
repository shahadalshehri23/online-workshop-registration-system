<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="420.0" prefWidth="480.0"
            style="-fx-background-color: #f4f6f7;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="online_workshop_regisration_syastem_project.controllers.auth.LoginController">

    <top>
        <HBox alignment="CENTER" style="-fx-background-color: #16a085; -fx-padding: 18;">
            <Label text="Online Workshop Registration System"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20.0">
            <padding>
                <Insets top="25.0" right="30.0" bottom="20.0" left="30.0" />
            </padding>

            <Label text="Login"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0e6655;" />

            <GridPane hgap="10.0" vgap="14.0" alignment="CENTER">
                <padding>
                    <Insets top="10.0" right="20.0" bottom="10.0" left="20.0" />
                </padding>

                <Label text="Email:"
                       style="-fx-font-weight: bold; -fx-text-fill: #0e6655;"
                       GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="emailField" promptText="Enter your email" prefWidth="240.0"
                           GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Password:"
                       style="-fx-font-weight: bold; -fx-text-fill: #0e6655;"
                       GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <PasswordField fx:id="passwordField" promptText="Enter your password" prefWidth="240.0"
                               GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </GridPane>

            <Button fx:id="loginButton" text="Login" prefWidth="160.0"
                    style="-fx-background-color: #117a65; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 16 8 16;" />
        </VBox>
    </center>

    <bottom>
        <Label fx:id="errorLabel" text=""
               style="-fx-text-fill: #c0392b; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets top="10.0" bottom="20.0" />
            </BorderPane.margin>
        </Label>
    </bottom>

</BorderPane>
