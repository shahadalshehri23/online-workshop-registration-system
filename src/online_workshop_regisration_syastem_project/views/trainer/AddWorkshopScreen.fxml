<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="500.0" prefWidth="560.0"
            style="-fx-background-color: #f4f6f7;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="online_workshop_regisration_syastem_project.controllers.trainer.AddWorkshopController">

    <top>
        <HBox alignment="CENTER" style="-fx-background-color: #16a085; -fx-padding: 18;">
            <Label text="Add New Workshop"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="15.0">
            <padding>
                <Insets top="25.0" right="40.0" bottom="20.0" left="40.0" />
            </padding>

            <Label text="Fill in the workshop details:"
                   style="-fx-font-weight: bold; -fx-text-fill: #0e6655;" />

            <GridPane hgap="12.0" vgap="14.0" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20;">

                <Label text="Title:"
                       style="-fx-font-weight: bold; -fx-text-fill: #0e6655;"
                       GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="titleField" promptText="Workshop title" prefWidth="280.0"
                           GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Description:"
                       style="-fx-font-weight: bold; -fx-text-fill: #0e6655;"
                       GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="descriptionField" promptText="Short description" prefWidth="280.0"
                           GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Date:"
                       style="-fx-font-weight: bold; -fx-text-fill: #0e6655;"
                       GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="dateField" promptText="YYYY-MM-DD" prefWidth="280.0"
                           GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Capacity:"
                       style="-fx-font-weight: bold; -fx-text-fill: #0e6655;"
                       GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="capacityField" promptText="Max participants" prefWidth="280.0"
                           GridPane.columnIndex="1" GridPane.rowIndex="3" />
            </GridPane>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 15;">
            <Button fx:id="saveButton" text="Save" prefWidth="140.0"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16 8 16;" />
            <Button fx:id="cancelButton" text="Cancel" prefWidth="140.0"
                    style="-fx-background-color: #566573; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16 8 16;" />
        </HBox>
    </bottom>

</BorderPane>
