<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="450.0" prefWidth="520.0"
            style="-fx-background-color: #f4f6f7;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="online_workshop_regisration_syastem_project.controllers.participant.ParticipantController">

    <top>
        <HBox alignment="CENTER" style="-fx-background-color: #16a085; -fx-padding: 18;">
            <Label text="Participant Dashboard"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="18.0">
            <padding>
                <Insets top="30.0" right="40.0" bottom="20.0" left="40.0" />
            </padding>

            <Label text="Welcome, Participant!"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0e6655;" />

            <Label text="Choose an action below:"
                   style="-fx-text-fill: #0e6655;" />

            <Button fx:id="browseWorkshopsButton" text="Browse Workshops" prefWidth="240.0"
                    style="-fx-background-color: #117a65; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 16 10 16;" />

            <Button fx:id="myWorkshopsButton" text="My Workshops" prefWidth="240.0"
                    style="-fx-background-color: #117a65; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 16 10 16;" />
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" style="-fx-padding: 15;">
            <Button fx:id="logoutButton" text="Logout" prefWidth="140.0"
                    style="-fx-background-color: #566573; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16 8 16;" />
        </HBox>
    </bottom>

</BorderPane>
